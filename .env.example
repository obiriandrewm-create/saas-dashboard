# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/saas_dashboard?schema=public"

# ============================================
# AUTH (NextAuth.js v5)
# ============================================
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ============================================
# ENCRYPTION KEYS (for TOTP secrets, etc.)
# ============================================
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=""          # Current KEK for envelope encryption
ENCRYPTION_KEY_VERSION="1" # Increment on rotation
ENCRYPTION_KEY_PREVIOUS="" # Previous KEK for decryption during rotation

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_API_VERSION="2024-06-20"

# Stripe Price IDs
STRIPE_PRICE_FREE="price_free"
STRIPE_PRICE_PRO_MONTHLY="price_pro_monthly"
STRIPE_PRICE_TEAM_MONTHLY="price_team_monthly"
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_enterprise_monthly"

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_REPLY_TO="support@yourdomain.com"

# ============================================
# CLOUDFLARE TURNSTILE (CAPTCHA)
# ============================================
TURNSTILE_SECRET_KEY="0x..."
TURNSTILE_SITE_KEY="0x..."

# ============================================
# REDIS (Sessions, Rate Limiting, Cache)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"